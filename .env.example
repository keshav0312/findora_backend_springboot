# Server
PORT=5000
# Socket.IO runs on its own port (netty-socketio). Point the frontend at it (see README).
SOCKET_PORT=5001

# Database (same MongoDB the Node backend used)
MONGODB_URI=mongodb://localhost:27017/findora

# Auth (REQUIRED - use the same values as before and existing tokens stay valid)
JWT_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret

# CORS - comma separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Where uploaded photos live (relative to the working directory)
UPLOAD_DIR=uploads

# Groq (AI match explanations) - optional, falls back to a template
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Brevo (transactional email) - optional, emails are logged when empty
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@findora.app
BREVO_SENDER_NAME=Findora

# WhatsApp Cloud API - optional
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v20.0
WHATSAPP_DEFAULT_COUNTRY_CODE=91

# Reports within this many km trigger the WhatsApp proximity alert
PROXIMITY_ALERT_KM=5
